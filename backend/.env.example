# Server
# Required. Use "production" on any deployed server.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8080

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sewa2026?schema=public

# Auth
# Required. Generate with: openssl rand -base64 48   (placeholders are rejected)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=sewa_session

# OTP (minimum length 6)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_CLEANUP_RETENTION_MINUTES=20

# Local development only: print OTP codes to the console (refused in production)
DEV_PRINT_OTP=false

# SMTP (email OTP delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-me
SMTP_FROM="SEWA 2026 <no-reply@sewa2026.dtu.ac.in>"

# File uploads (team registration ID card: PDF/JPG/PNG, 5 MB max)
UPLOAD_DIR=uploads/id-cards

# Multi-instance deployment (set by deploy/docker-compose.yml on the VM)
# REDIS_URL=redis://127.0.0.1:6379
# TRUST_PROXY_HOPS=1
# ENABLE_IN_PROCESS_CRON=true
# HOST=127.0.0.1



