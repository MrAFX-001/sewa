generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  pending
  active
  suspended
}

enum OtpPurpose {
  email_verify
  password_reset
}

enum TeamRole {
  leader
  member
}

enum TeamStatus {
  draft
  submitted
  under_review
  shortlisted
  rejected
}

enum ContactMessageStatus {
  open
  resolved
}

model User {
  id              String   @id @default(uuid())
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  email           String   @unique @db.Citext
  phone           String?  @db.VarChar(15)
  passwordHash    String   @map("password_hash")
  emailVerified   Boolean  @default(false) @map("email_verified")
  status          UserStatus @default(pending)
  tokenVersion Int @default(0) @map("token_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  otps            OtpVerification[]
  ledTeams        Team[]       @relation("TeamLeader")
  teamMemberships TeamMember[]
  auditLogs       AuditLog[]
  candidateProfile CandidateProfile?
  
  @@map("users")
}

/**
 * The "Personal Details" step of the registration dossier - KYC-style
 * fields about the applicant that don't belong on the auth-focused User
 * model. One-to-one with User; created/updated as a whole via PUT /api/profile.
 */
model CandidateProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  middleName  String? @map("middle_name") @db.VarChar(100)
  category    String? @db.VarChar(50) // Category / Social Group (for MoE analytics)
  nationality String  @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth")
  gender      String  @db.VarChar(30)

  // Stored as entered per product decision - no masking/truncation.
  aadhaarNumber String @map("aadhaar_number") @db.VarChar(20)

  addressLine1 String  @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  pinCode      String  @map("pin_code") @db.VarChar(10)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  country      String  @db.VarChar(100)

  alternatePhone String? @map("alternate_phone") @db.VarChar(15)
  backupEmail    String? @map("backup_email") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("candidate_profiles")
}

model OtpVerification {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose @default(email_verify)
  attempts    Int        @default(0) @db.SmallInt
  maxAttempts Int        @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("otp_verifications")
}

// PS = the official problem statement we supply for that category (national
// categories only). OPEN = the team proposes and solves its own problem
// within the category (the only option regional categories offer).
enum ProblemOptionType {
  ps
  open
}

// Assigns the sequential "-OP-NNN" suffix atomically per category, e.g.
// NAT-001-OP-001, NAT-001-OP-002 ... The row is upserted with lastSeq
// incremented inside a transaction, which Postgres serialises on the row's
// primary key - two concurrent submissions for the same category cannot be
// assigned the same sequence number. See problemStatement.service.ts.
model ProblemStatementCounter {
  categoryCode String   @id @map("category_code") @db.VarChar(20)
  lastSeq      Int      @default(0) @map("last_seq")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("problem_statement_counters")
}

model Team {
  id               String  @id @default(uuid())
  name             String  @db.VarChar(150)
  institute        String  @db.VarChar(200)
  // Free text describing the org/institute/school's postal address, so the
  // physical location of a team's affiliation is on record (e.g. for
  // regional-hub logistics, verification, or dispatch of physical material).
  institutionAddress String @map("institution_address") @db.VarChar(300)
  theme            String  @db.VarChar(150)
  problemStatement String  @map("problem_statement") @db.VarChar(200)
  // Structured problem-selection fields, validated server-side against the
  // PROBLEM_CATEGORIES catalogue (see config/problemCategories.ts) rather
  // than trusted as arbitrary client text - this is what makes `theme` and
  // `problemStatement` above trustworthy: both are now DERIVED from these,
  // not accepted verbatim from the request body. Kept as plain columns
  // rather than a relational category table since the catalogue is a small,
  // static, per-season list edited in code alongside the frontend's own
  // copy of it - promote to a real table if categories start changing
  // between seasons or need to be admin-editable.
  problemCategoryCode      String            @map("problem_category_code") @db.VarChar(20)
  problemOptionType        ProblemOptionType @map("problem_option_type")
  // Required (and only meaningful) when problemOptionType = open; NULL when
  // = ps. Enforced both in Zod (schemas/team.schema.ts) and by a DB CHECK
  // constraint (see migration) so this can't be left inconsistent even by a
  // future direct DB write that skips the API.
  proposedProblemStatement String?           @map("proposed_problem_statement") @db.VarChar(500)
  // The final assigned ID: "NAT-001-PS" for an official PS (shared by every
  // team that picks it - NOT unique), or "NAT-001-OP-003" for an open
  // proposal (unique by construction via ProblemStatementCounter).
  problemStatementId       String            @map("problem_statement_id") @db.VarChar(40)
  // Uploaded organisation/institution ID card (PDF or image). Path is a
  // server-relative path under env.UPLOAD_DIR, never a client-supplied
  // value - see middleware/upload.middleware.ts.
  idCardPath         String  @map("id_card_path") @db.VarChar(500)
  idCardMimeType     String  @map("id_card_mime_type") @db.VarChar(100)
  idCardOriginalName String? @map("id_card_original_name") @db.VarChar(255)
  leaderUserId     String  @map("leader_user_id")
  leader       User       @relation("TeamLeader", fields: [leaderUserId], references: [id])
  status       TeamStatus @default(draft)
  submittedAt  DateTime?  @map("submitted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  members      TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.Citext
  phone     String?  @db.VarChar(15)
  role      TeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, email])
  @@map("team_members")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/**
 * A submission from the public Contact Us / Grievance form. Deliberately
 * has no relation to User: the form is reachable without signing in (an
 * applicant might be locked out and filing a grievance about exactly
 * that), so it captures the submitter's stated name/email/phone as plain
 * fields rather than assuming an account exists.
 */
model ContactMessage {
  id       String                @id @default(uuid())
  category String                @db.VarChar(60)
  fullName String                @map("full_name") @db.VarChar(200)

  // Free text: an applicant may quote a team UUID or a college roll
  // number here, neither of which is validated against the teams table.
  teamOrAffiliationId String? @map("team_or_affiliation_id") @db.VarChar(100)

  email   String @db.Citext
  phone   String @db.VarChar(15)
  subject String @db.VarChar(200)
  message String @db.Text

  status ContactMessageStatus @default(open)

  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

/**
 * A public-facing notice/announcement item displayed on the homepage.
 * Created by admins; read publicly without auth via GET /api/announcements.
 */
model Announcement {
  id          String   @id @default(uuid())
  refNumber   String?  @map("ref_number") @db.VarChar(50)
  category    String   @db.VarChar(60)
  title       String   @unique @db.VarChar(200)
  summary     String   @db.Text
  detail      String?  @db.Text
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([publishedAt(sort: Desc)])
  @@map("announcements")
}

