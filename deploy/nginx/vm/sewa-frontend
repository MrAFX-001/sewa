server {

    server_name sewafirstryic.dtu.ac.in www.sewafirstryic.dtu.ac.in;

    include /etc/nginx/snippets/sewa-site-locations.conf;

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/sewafirstryic.dtu.ac.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/sewafirstryic.dtu.ac.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    listen 80;
    listen [::]:80;

    server_name sewafirstryic.dtu.ac.in www.sewafirstryic.dtu.ac.in;

    return 301 https://$host$request_uri;
}



